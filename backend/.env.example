# Copy to .env and fill in. .env is gitignored — never commit.

# --- Meld ---
# Sandbox API key from the Meld dashboard. LEAVE BLANK to run in MOCK mode
# (quotes/sessions/statuses served locally, zero external dependency).
MELD_API_KEY=
# "sandbox" -> https://api-sb.meld.io ; "production" -> https://api.meld.io
MELD_ENV=sandbox
MELD_VERSION=2026-02-03
# Force mock even if a key is set (useful for offline demos): "true" | "false".
FORCE_MOCK=

# --- Server ---
PORT=8787
CORS_ORIGIN=http://localhost:5173
REDIRECT_URL=http://localhost:5173/done

# --- Deposit-amount math buffers (Stage A) ---
HOST_CONV_RATE=1
HOST_CONV_BUFFER=0.01
HOST_GAS_RESERVE=0.02
DEST_EXISTENTIAL=0.01
SLIPPAGE_CARD=0.01
SLIPPAGE_BANK=0.02

# --- Mock coinage handoff (stand-in for the real host coinage flow) ---
# Ephemeral deposit address is generated per session in mock mode; this seeds it.
MOCK_EPHEMERAL_PREFIX=5Ephemeral
